# Copy this file to .env and fill it in. .env is git-ignored; never commit it.

# --- Model (OpenAI Agents SDK) -------------------------------------------
OPENAI_API_KEY=
# Leave empty to use the Agents SDK default model.
OPENAI_MODEL=

# --- Data tool: your Moodle calendar export ------------------------------
# Moodle -> Calendar -> Import or export calendars -> Export calendar ->
# "All events" + "Recent and next 60 days" -> Get calendar URL. Paste it here.
# (For offline rehearsal use samples/moodle_sample.ics instead.)
MOODLE_ICAL_URL=
MOODLE_TIMEOUT_SECONDS=15

# --- Action tool: where events are written -------------------------------
# google = your real Google Calendar; local = data/local_calendar.json (rehearsal)
CALENDAR_BACKEND=google
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
LOCAL_CALENDAR_FILE=data/local_calendar.json

# --- Preferences -----------------------------------------------------------
TIMEZONE=Asia/Beirut
# Default "notify me X hours before" when you don't say otherwise (0-672).
DEFAULT_REMIND_HOURS=24
